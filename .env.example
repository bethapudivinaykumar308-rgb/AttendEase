# ---------------------------------------------------------------------------
# AttendEase - Student Attendance Management System
#
# Copy this file to `.env` in the repository root (or to `backend/.env` for a
# local, non-Docker run) and adjust the values for your machine.
#
# NEVER commit a real `.env` file. `.env` is already listed in .gitignore.
# ---------------------------------------------------------------------------

# --- Database (MySQL 8) ---------------------------------------------------
# Dedicated application user (least privilege), never the MySQL root account.
# Generate a strong local password, URL-encode special characters, and keep
# the real value only in backend/.env (which is git-ignored).
DATABASE_URL="mysql://attendease:CHANGE_ME@127.0.0.1:3307/attendance_management"

# --- Application ----------------------------------------------------------
NODE_ENV="development"
API_PORT="5000"
APP_URL="http://localhost:5173"
API_URL="http://localhost:5000"

# Secret used to sign JWT session cookies. Generate a new one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="8h"

# --- Password reset -------------------------------------------------------
# Lifetime of a password-reset token in minutes.
RESET_TOKEN_TTL_MINUTES="30"

# --- Attendance policy ----------------------------------------------------
# Percentage below which a student is flagged as low attendance.
ATTENDANCE_THRESHOLD_PERCENT="75"
# Statuses that count as "attended" when computing attendance percentage.
ATTENDANCE_COUNTED_STATUSES="PRESENT,LATE"

# --- Cookies --------------------------------------------------------------
# Set to true in production (served over HTTPS) so the session cookie is only
# ever transmitted over an encrypted channel.
SECURE_COOKIES="false"

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS="http://localhost:5173"

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES="15"
RATE_LIMIT_MAX="300"
AUTH_RATE_LIMIT_MAX="20"

# --- Logging --------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL="info"

# --- Docker Compose only --------------------------------------------------
# Used by `docker compose up` to initialise the bundled MySQL 8 service.
# MYSQL_ROOT_PASSWORD="CHANGE_ME"
# MYSQL_DATABASE="attendance_management"
# MYSQL_USER="attendease"
# MYSQL_PASSWORD="CHANGE_ME"
# WEB_PORT="8080"
